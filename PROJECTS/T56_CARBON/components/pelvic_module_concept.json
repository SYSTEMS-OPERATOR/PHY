  "domestic_contact_rules": [
    "Pelvis breadth must come from the validated T-5.6 anthropometric profile, never from visual-reference pixel scaling.",
    "External iliac corners require rounded sacrificial covers or compliant overmolded contact layers.",
    "Fasteners within likely contact zones must be recessed or covered.",
    "Hip pinch zones require guards that remain effective through the validated joint range.",
    "Hard structural surfaces require thermal and pressure isolation from the outer contact layer.",
    "Primary service operations must be possible with the body safely supported in a reclined maintenance posture."
  ],
  "validation_plan": [
    "define pelvis static and dynamic design load cases",
    "resolve validated anthropometric pelvis targets",
    "analyze sacral bridge bending and torsion",
    "test bonded and mechanically captured hip-node inserts",
    "validate left and right hip cartridge retention",
    "cycle-test hip motion with guards installed",
    "measure pelvis acoustic output and vibration transmission",
    "validate fascia-anchor pull-out and load spreading",
    "perform service-access rehearsal in supported reclined posture",
    "perform contact-pressure and thermal-surface review"
  ],
  "release_blockers": [
    "validated T-5.6 pelvis dimensions",
    "defined load cases and safety factors",
    "selected composite system and traceable datasheet",
    "selected insert alloy and dielectric isolation system",
    "resolved hip kinematics and actuation",
    "validated laminate and insert geometry",
    "passed destructive coupons and pelvic subassembly tests"
  ]
